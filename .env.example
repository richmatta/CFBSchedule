# Server-only. Get a key at https://collegefootballdata.com/key
CFBD_API_KEY=
# auto prefers ESPN SP+ for the supported current season, then enabled CFBD SP+, then Elo.
RATING_MODEL=auto
CFBD_SP_ENABLED=false
# Leave false to use real data when a key is configured.
DEMO_MODE=false

# ESPN SP+ is preferred for the supported current season (2026). Set false to disable.
ESPN_SP_ENABLED=true
